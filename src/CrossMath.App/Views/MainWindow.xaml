<Window x:Class="CrossMath.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CrossMath.App.ViewModels"
        xmlns:b="clr-namespace:CrossMath.App.Behaviors"
        xmlns:conv="clr-namespace:CrossMath.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="CrossMath" Icon="/Assets/CrossMath.ico" Width="780" Height="860" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        b:WindowPlacementBehavior.Placement="{Binding WindowPlacement, Mode=TwoWay}"
        Background="#F4F1EA" FontFamily="Segoe UI">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:TimeSpanToStringConverter x:Key="TimeText" />
        <!-- Fill for a tile placed on the board: tray colors normally, tinted by Check results or a hint. -->
        <conv:CellStateToBrushConverter x:Key="PlacedTileBrush"
                                        Normal="#FFF6DA" Correct="#CDEFD0" Wrong="#F7C9C9" Hinted="#D3E4FA" />

        <SolidColorBrush x:Key="Ink" Color="#2E2A24" />
        <SolidColorBrush x:Key="PlayerInk" Color="#1F5FB4" />
        <SolidColorBrush x:Key="TileFill" Color="#FFF6DA" />
        <SolidColorBrush x:Key="TileEdge" Color="#C9A44C" />
        <SolidColorBrush x:Key="SelectEdge" Color="#E07B18" />

        <!-- Board squares butt together on an ink background, so the gaps read as grid lines. -->
        <Style x:Key="Square" TargetType="Border">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="PoolSquare" TargetType="Border">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- White backing so the number notches into the corner of a placed tile instead of overlapping it. -->
        <Style x:Key="ClueNumberText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="3,1,2,1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Text" Value="{Binding ClueNumber}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ClueNumber}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SquareText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <DataTemplate x:Key="BlockedCell">
            <!-- Transparent: the board's ink background shows through, without anti-aliased seams. -->
            <Border Style="{StaticResource Square}" Background="Transparent" />
        </DataTemplate>

        <DataTemplate x:Key="SymbolCell" DataType="{x:Type vm:CellViewModel}">
            <Border Style="{StaticResource Square}">
                <TextBlock Style="{StaticResource SquareText}" Text="{Binding Text}" Foreground="#6B6357" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GivenCell" DataType="{x:Type vm:CellViewModel}">
            <Border Style="{StaticResource Square}">
                <Grid>
                    <TextBlock Style="{StaticResource SquareText}" Text="{Binding Text}" FontWeight="Bold" />
                    <TextBlock Style="{StaticResource ClueNumberText}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BlankCell" DataType="{x:Type vm:CellViewModel}">
            <Border x:Name="Box" Style="{StaticResource Square}"
                    Cursor="Hand"
                    b:DragSource.CanDrag="{Binding CanDrag}"
                    b:DragSource.ClickCommand="{Binding DataContext.CellClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    b:DragSource.RightClickCommand="{Binding DataContext.ReturnTileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    b:DropTarget.Command="{Binding DataContext.MoveTileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="Drop a tile here. Right-click to send it back.">
                <Grid>
                    <!-- A placed tile looks the same as in the tray, so movable numbers stand apart from the
                         fixed, printed ones. -->
                    <Border x:Name="PlacedTile" Margin="4" CornerRadius="6" BorderThickness="2"
                            BorderBrush="{StaticResource TileEdge}"
                            Background="{Binding State, Converter={StaticResource PlacedTileBrush}}"
                            Visibility="{Binding HasTile, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Name="Value" Style="{StaticResource SquareText}" Text="{Binding DisplayText}"
                                   FontSize="20" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Style="{StaticResource ClueNumberText}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="PlacedTile" Property="BorderBrush" Value="{StaticResource SelectEdge}" />
                    <Setter TargetName="PlacedTile" Property="BorderThickness" Value="3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="Box" Property="Cursor" Value="Arrow" />
                    <Setter TargetName="PlacedTile" Property="BorderBrush" Value="{StaticResource PlayerInk}" />
                    <Setter TargetName="Value" Property="Foreground" Value="{StaticResource PlayerInk}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <conv:CellTemplateSelector x:Key="CellSelector"
                                   BlockedTemplate="{StaticResource BlockedCell}"
                                   SymbolTemplate="{StaticResource SymbolCell}"
                                   GivenTemplate="{StaticResource GivenCell}"
                                   BlankTemplate="{StaticResource BlankCell}" />

        <DataTemplate x:Key="PoolTile" DataType="{x:Type vm:TileViewModel}">
            <Border x:Name="Tile" Style="{StaticResource PoolSquare}"
                    Background="{StaticResource TileFill}" BorderBrush="{StaticResource TileEdge}" BorderThickness="2"
                    Cursor="Hand"
                    b:DragSource.CanDrag="True"
                    b:DragSource.ClickCommand="{Binding DataContext.SelectTileCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Style="{StaticResource SquareText}" Text="{Binding Value}" FontWeight="SemiBold" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource SelectEdge}" />
                    <Setter TargetName="Tile" Property="BorderThickness" Value="3" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Text="CrossMath" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding SelectedDifficulty}"
                      IsEnabled="{Binding IsIdle}" Width="100" VerticalContentAlignment="Center" FontSize="14" />
            <Button Content="New Game" Command="{Binding NewGameCommand}" />
            <Button Content="Check" Command="{Binding CheckCommand}" />
            <Button Content="Hint" Command="{Binding HintCommand}" />
            <Button Content="Undo" Command="{Binding UndoCommand}" ToolTip="Undo the last move or hint (Ctrl+Z)" />
            <Button Content="Reset" Command="{Binding ResetCommand}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⏱ " FontSize="18" />
                <TextBlock Text="{Binding Elapsed, Converter={StaticResource TimeText}}" FontSize="20"
                           FontFamily="Consolas" Foreground="{StaticResource Ink}" />
            </StackPanel>
        </DockPanel>

        <!-- Status -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" FontSize="14" Margin="0,10,0,0"
                   Foreground="#5A5247" TextWrapping="Wrap" />

        <!-- Tile pool, with the solved banner layered on top: once solved every tile is on the board,
             so the pool is empty and the banner never covers the puzzle or a tile. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border DataContext="{Binding Pool}" Padding="8"
                    MinHeight="76" CornerRadius="8" Background="#EAE3D2" BorderBrush="#D3C8B0" BorderThickness="1"
                    b:DropTarget.Command="{Binding DataContext.MoveTileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="Tiles to place. Drag a tile back here to remove it from the board.">
                <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource PoolTile}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>

            <Border Visibility="{Binding IsSolved, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,10"
                    CornerRadius="10" Background="#2F8F4E" IsHitTestVisible="False">
                <TextBlock Text="{Binding StatusMessage}" FontSize="20" FontWeight="SemiBold" Foreground="White" />
            </Border>
        </Grid>

        <!-- Board -->
        <Grid>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Border Background="{StaticResource Ink}" Padding="3">
                    <ItemsControl ItemsSource="{Binding Cells}" ItemTemplateSelector="{StaticResource CellSelector}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </Viewbox>

            <Border Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}"
                    Background="#B3F4F1EA">
                <TextBlock Text="Generating…" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource Ink}" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
