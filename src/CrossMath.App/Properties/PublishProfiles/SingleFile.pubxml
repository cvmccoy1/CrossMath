<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained single-file exe for 64-bit Windows; runs without .NET installed.
     dotnet publish src/CrossMath.App -p:PublishProfile=SingleFile -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF ships native DLLs (wpfgfx, PresentationNative, D3DCompiler); bundle them too. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- Don't copy referenced projects' .pdb files next to the exe. -->
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\publish\</PublishDir>
  </PropertyGroup>
</Project>
